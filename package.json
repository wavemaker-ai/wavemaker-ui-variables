{
  "name": "@wavemaker-ai/variables",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "module": "index",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist/es2015',{recursive:true,force:true}); fs.rmSync('dist/umd',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && webpack  --mode development && node ./scripts/build.js post-build",
    "yalc-publish": "cd dist/es2015 && yalc publish --no-dev-mod --no-sig --push --content",
    "watch": "npm-watch build",
    "test": "jest"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "import": "./*.js",
      "require": "./*.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.28.6",
    "@types/jest": "^30.0.0",
    "execa": "5.1.1",
    "fs-extra": "11.3.4",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "tar": "7.5.22",
    "ts-jest": "^29.4.12",
    "ts-loader": "9.5.4",
    "typescript": "5.7.2",
    "webpack": "5.105.4",
    "webpack-cli": "4.10.0",
    "yargs": "16.2.0"
  },
  "dependencies": {
    "@metrichor/jmespath": "0.3.1",
    "he": "1.2.0",
    "lodash-es": "4.18.1",
    "moment": "2.30.1",
    "x2js": "3.4.4"
  },
  "watch": {
    "build": {
      "patterns": [
        "src"
      ],
      "extensions": "ts,js",
      "ignore": "src/vendor/external.min.js",
      "quiet": true,
      "legacyWatch": true,
      "delay": 2500,
      "runOnChangeOnly": true
    }
  }
}
