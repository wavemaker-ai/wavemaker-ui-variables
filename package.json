{
  "name": "@wavemaker-ai/variables",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "module": "index",
  "scripts": {
    "build": "tsc && webpack  --mode development && node ./scripts/build.js post-build",
    "yalc-publish": "cd dist/es2015 && yalc publish --no-dev-mod --no-sig --push --content",
    "watch": "npm-watch build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "import": "./*.js",
      "require": "./*.js"
    },
    "./package.json": "./package.json"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "execa": "^5.0.0",
    "fs-extra": "^11.1.0",
    "tar": "7.5.22",
    "ts-loader": "^9.3.1",
    "typescript": "5.7.2",
    "webpack": "^5.73.0",
    "webpack-cli": "^4.10.0",
    "yargs": "16.2.0"
  },
  "dependencies": {
    "@metrichor/jmespath": "^0.3.1",
    "he": "^1.2.0",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.4",
    "x2js": "^3.4.3"
  },
  "watch": {
    "build": {
      "patterns": [
        "src"
      ],
      "extensions": "ts,js",
      "ignore": "src/vendor/external.min.js",
      "quiet": true,
      "legacyWatch": true,
      "delay": 2500,
      "runOnChangeOnly": true
    }
  }
}
